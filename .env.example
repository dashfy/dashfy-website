# Ask AI (docs chat). Without these the /api/chat route returns 503 and the rest
# of the site works normally, so they are optional for local development.

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini. Every request sends the whole docs corpus,
# so prefer a small model and keep a spend cap on the account.
OPENAI_MODEL=

# Optional, and only useful together. They make /api/chat share one rate limit
# across every serverless instance via Upstash Redis. Leave them blank to use the
# in-memory limiter instead, which counts per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
